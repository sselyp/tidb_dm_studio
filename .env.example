# ---- Server ----
# 后端监听地址与端口
DM_WEB_LISTEN=0.0.0.0:8080
# 运行模式: dev | prod
DM_WEB_ENV=dev
# 前端来源（CORS / cookie 校验）
DM_WEB_ALLOWED_ORIGIN=http://localhost:5173

# ---- Auth ----
# 初始管理员口令（仅首次初始化使用，登录后强制修改；勿提交真实值）
DM_WEB_ADMIN_INIT_PASSWORD=change-me-on-first-login
# 主密钥：AES-256-GCM，用于加密数据源口令；32 字节 base64
DM_WEB_MASTER_KEY=

# ---- Session ----
# 单实例留空使用内存；多实例填 Redis
DM_WEB_SESSION_REDIS_ADDR=
DM_WEB_SESSION_TTL=24h

# ---- DM Cluster ----
# dm-master 地址，多个用逗号分隔
# 地址口径（实测）：开发机 / 后端代理 / 前端联调用 http://10.168.2.241:8261；
# 仅 rocky241 宿主内可用 127.0.0.1:8261；勿按 192.168.2.x 段配置（开发/代理侧不可达）。
DM_MASTER_ADDRS=http://127.0.0.1:8261

# ---- Frontend ----
VITE_API_BASE=/api
